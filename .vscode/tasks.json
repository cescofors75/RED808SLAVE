{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO: Build",
			"type": "shell",
			"command": "${userHome}/.platformio/penv/Scripts/platformio.exe run",
			"problemMatcher": [
				"$platformio"
			],
			"group": "build"
		},
		{
			"label": "PlatformIO: Upload Filesystem",
			"type": "shell",
			"command": "${userHome}/.platformio/penv/Scripts/platformio.exe run --target uploadfs",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "PlatformIO: Upload S3",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/.vscode/upload_device.ps1",
				"-Device", "s3",
				"-Target", "upload",
				"-ProjectDir", "${workspaceFolder}/RedMaster_ESP32S3"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "PlatformIO: Flash Daisy",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/RedMaster_DaisySeed64MB/flash_daisy.ps1"
			],
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "PlatformIO: Flash Daisy (SkipSamples)",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/RedMaster_DaisySeed64MB/flash_daisy.ps1",
				"-SkipSamples"
			],
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "PlatformIO: Build Verbose S3",
			"type": "shell",
			"command": "${userHome}/.platformio/penv/Scripts/platformio.exe run --environment esp32s3 --verbose 2>&1 | Select-String -Pattern 'error:|warning:C' | Select-Object -First 40",
			"group": "build"
		},
		{
			"label": "PlatformIO: Upload Filesystem P4",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/.vscode/upload_device.ps1",
				"-Device", "p4",
				"-Target", "uploadfs",
				"-ProjectDir", "${workspaceFolder}/BlueSlaveP4",
				"-Environment", "esp32p4-fs"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "PlatformIO: Upload P4",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/.vscode/upload_device.ps1",
				"-Device", "p4",
				"-Target", "upload",
				"-ProjectDir", "${workspaceFolder}/BlueSlaveP4",
				"-Environment", "esp32p4-fs"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "PlatformIO: Monitor P4",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/.vscode/monitor_device.ps1",
				"-Device", "p4"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "PlatformIO: Monitor S3",
			"type": "shell",
			"command": "pwsh.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy", "Bypass",
				"-File", "${workspaceFolder}/.vscode/monitor_device.ps1",
				"-Device", "s3"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		},
		{
			"label": "Inspect MEM MIDIs (Python)",
			"type": "shell",
			"command": "python",
			"args": [
				"${workspaceFolder}/scripts/inspect_mid.py",
				"${workspaceFolder}/BlueSlaveP4/data/mid"
			],
			"problemMatcher": []
		}
	]
}